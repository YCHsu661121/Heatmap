{
  "name": "stock-heatmap",
  "displayName": "Stock Heatmap",
  "description": "股票熱力圖、K 線圖、技術指標與 LLM 建議整合 VS Code 插件",
  "version": "0.1.0",
  "publisher": "visualebios",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "stock",
    "heatmap",
    "kline",
    "chart",
    "finance",
    "trading",
    "LLM"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stockHeatmap.openDashboard",
        "title": "Stock Heatmap: Open Dashboard"
      },
      {
        "command": "stockHeatmap.refresh",
        "title": "Stock Heatmap: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "stockHeatmap.addSymbol",
        "title": "Stock Heatmap: Add Symbol",
        "icon": "$(add)"
      },
      {
        "command": "stockHeatmap.removeSymbol",
        "title": "Stock Heatmap: Remove Symbol",
        "icon": "$(trash)"
      },
      {
        "command": "stockHeatmap.analyzeSymbol",
        "title": "Stock Heatmap: Analyze Current Symbol"
      },
      {
        "command": "stockHeatmap.addAlertRule",
        "title": "Stock Heatmap: Add Alert Rule",
        "icon": "$(bell-dot)"
      },
      {
        "command": "stockHeatmap.manageAlerts",
        "title": "Stock Heatmap: Manage Alerts",
        "icon": "$(bell)"
      },
      {
        "command": "stockHeatmap.runAlertCheck",
        "title": "Stock Heatmap: Run Alert Check Now"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stock-heatmap",
          "title": "Stock Heatmap",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "stock-heatmap": [
        {
          "id": "stockHeatmap.watchlist",
          "name": "自選股清單",
          "icon": "media/icon.svg"
        },
        {
          "id": "stockHeatmap.signals",
          "name": "訊號清單"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stockHeatmap.refresh",
          "when": "view == stockHeatmap.watchlist",
          "group": "navigation"
        },
        {
          "command": "stockHeatmap.addSymbol",
          "when": "view == stockHeatmap.watchlist",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "stockHeatmap.removeSymbol",
          "when": "view == stockHeatmap.watchlist && viewItem == watchlistItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Stock Heatmap",
      "properties": {
        "stockHeatmap.market": {
          "type": "string",
          "default": "TW",
          "enum": ["TW", "US"],
          "description": "目標市場（TW = 台股 / US = 美股）"
        },
        "stockHeatmap.apiProvider": {
          "type": "string",
          "default": "finmind",
          "enum": ["finmind", "finnhub"],
          "description": "市場資料 API Provider"
        },
        "stockHeatmap.apiKey": {
          "type": "string",
          "default": "",
          "description": "市場資料 API Key"
        },
        "stockHeatmap.refreshIntervalSec": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "自動刷新間隔（秒，最小 10）"
        },
        "stockHeatmap.watchlist": {
          "type": "array",
          "default": [],
          "description": "自選股清單（含中文名稱與分群）",
          "items": {
            "type": "object",
            "required": ["symbol", "name", "group"],
            "properties": {
              "symbol": { "type": "string", "description": "股票代碼，例如 2330、AAPL" },
              "name":   { "type": "string", "description": "中文名稱，例如 台積電" },
              "group":  { "type": "string", "description": "群組名稱，例如 半導體" }
            }
          }
        },
        "stockHeatmap.llm.mode": {
          "type": "string",
          "default": "single",
          "enum": ["single", "fallback", "parallel", "consensus"],
          "description": "LLM 分析模式"
        },
        "stockHeatmap.llm.primaryProvider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "ollama", "copilot"],
          "description": "主要 LLM provider"
        },
        "stockHeatmap.llm.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "主要 LLM 模型名稱"
        },
        "stockHeatmap.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API Key（使用 OpenAI 時必填）"
        },
        "stockHeatmap.llm.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama 本地端點 URL"
        },
        "stockHeatmap.llm.ollamaEndpoints": {
          "type": "array",
          "default": [],
          "description": "多個 Ollama 端點清單（LlmEndpoint[]）"
        },
        "stockHeatmap.llm.copilotModelFamily": {
          "type": "string",
          "default": "gpt-4o",
          "description": "透過 VS Code LM API 選取的 Copilot model family"
        },
        "stockHeatmap.llm.mergeStrategy": {
          "type": "string",
          "default": "primary",
          "enum": ["primary", "fallback", "majority", "weighted", "showAll"],
          "description": "多模型彙總策略"
        },
        "stockHeatmap.llm.timeoutMs": {
          "type": "number",
          "default": 20000,
          "description": "單模型分析逾時毫秒數"
        },
        "stockHeatmap.llm.defaultTeamId": {
          "type": "string",
          "default": "",
          "description": "預設固定協作組 ID"
        },
        "stockHeatmap.llm.teams": {
          "type": "array",
          "default": [],
          "description": "已儲存的固定 LLM 協作組設定（LlmTeamConfig[]）"
        },
        "stockHeatmap.llm.maxParallelModels": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "單次同時執行的最大模型數"
        },
        "stockHeatmap.chartInsights.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否啟用圖表分析說明"
        },
        "stockHeatmap.chartInsights.mode": {
          "type": "string",
          "default": "hybrid",
          "enum": ["local", "llm", "hybrid"],
          "description": "圖表說明模式：local（純本地模板）/ llm（只用 LLM）/ hybrid（本地優先，LLM 補充）"
        },
        "stockHeatmap.chartInsights.autoExplainOnSelect": {
          "type": "boolean",
          "default": true,
          "description": "選取圖表區段時是否自動產生說明"
        },
        "stockHeatmap.financials.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否啟用財報抓取與分析"
        },
        "stockHeatmap.financials.provider": {
          "type": "string",
          "default": "official",
          "enum": ["official", "mixed"],
          "description": "財報資料來源：official（官方 MOPS / SEC EDGAR）/ mixed（官方 + 補充來源）"
        },
        "stockHeatmap.financials.lookbackQuarters": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "預設分析最近幾季財報"
        },
        "stockHeatmap.news.provider": {
          "type": "string",
          "default": "newsapi",
          "enum": ["newsapi", "rss"],
          "description": "新聞來源：newsapi / rss"
        },
        "stockHeatmap.news.apiKey": {
          "type": "string",
          "default": "",
          "description": "News API Key"
        },
        "stockHeatmap.news.lookbackDays": {
          "type": "number",
          "default": 7,
          "description": "新聞回溯天數"
        },
        "stockHeatmap.alerts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否啟用提醒系統"
        },
        "stockHeatmap.alerts.defaultCooldownSec": {
          "type": "number",
          "default": 1800,
          "description": "預設提醒冷卻時間（秒）"
        },
        "stockHeatmap.alerts.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "是否顯示狀態列提醒"
        },
        "stockHeatmap.screener.defaultScope": {
          "type": "string",
          "default": "watchlist",
          "enum": ["watchlist", "market"],
          "description": "預設選股範圍"
        },
        "stockHeatmap.screener.maxSymbols": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "description": "單次篩選最大標的數"
        },
        "stockHeatmap.calendar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否啟用事件日曆"
        },
        "stockHeatmap.calendar.lookaheadDays": {
          "type": "number",
          "default": 14,
          "description": "事件預讀天數"
        },
        "stockHeatmap.portfolio.enabled": {
          "type": "boolean",
          "default": false,
          "description": "是否啟用投組觀察"
        },
        "stockHeatmap.storage.cacheTtlSec": {
          "type": "number",
          "default": 300,
          "description": "一般資料快取秒數"
        },
        "stockHeatmap.storage.persistWatchlistLayout": {
          "type": "boolean",
          "default": true,
          "description": "是否保存 watchlist 排序與群組"
        },
        "stockHeatmap.signal.rsiOverbought": {
          "type": "number",
          "default": 70,
          "description": "RSI 超買閾值"
        },
        "stockHeatmap.signal.rsiOversold": {
          "type": "number",
          "default": 30,
          "description": "RSI 超賣閾值"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle -- --minify",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run bundle",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "npm run bundle -- --watch",
    "lint": "eslint src --ext ts",
    "pretest": "npm run bundle",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "openai": "^4.47.0",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0"
  }
}
