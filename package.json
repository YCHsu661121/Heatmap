{
  "name": "heatmap",
  "displayName": "Stock Heatmap",
  "description": "Stock market analysis toolkit inside VS Code",
  "version": "2.0.0",
  "publisher": "cogito",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:stockHeatmap.watchlistView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "stockHeatmap.watchlistView",
          "name": "Stock Watchlist"
        }
      ]
    },
    "configuration": {
      "title": "Stock Heatmap",
      "properties": {
        "stockHeatmap.watchlist": {
          "type": "array",
          "default": [],
          "description": "List of stock symbols to watch"
        },
        "stockHeatmap.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for market data"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "package": "vsce package --out dist/heatmap.vsix"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/technicalindicators": "^3.0.13",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.54.0",
    "glob": "^10.3.0",
    "mocha": "^10.2.0",
    "typescript": "~5.3.3",
    "vscode-test": "^1.6.1",
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "date-fns": "^3.0.0",
    "openai": "^4.47.1",
    "rss-parser": "^3.13.0",
    "technicalindicators": "^3.1.0",
    "ws": "^8.14.2"
  }
}
